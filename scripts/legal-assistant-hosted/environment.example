# Workers only. Do not set these paths/mode or the API key on Vercel.
# ORCHESTRATOR_HOSTED_WORKER=true
# ORCHESTRATOR_WORKER_CACHE_DIR=<owner-only persistent cache>
# ORCHESTRATOR_AUDIT_OPENAI_KEY=<private existing key>
# ORCHESTRATOR_AUDIT_PYTHON=<absolute venv python>
# ORCHESTRATOR_COO_PYTHON=<absolute venv python>
# ORCHESTRATOR_AUDIT_OCR=<absolute tested OCR helper>
# Never set ORCHESTRATOR_LOCAL_STATE_DIR in hosted mode.
# Existing NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY stay as Admin auth config.
