# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migrations
# Applied by hand in the Supabase SQL editor, never auto-run by a deploy, so
# they are kept local rather than pushed. NOTE: this only affects NEW files —
# the migrations already tracked stay tracked until `git rm --cached` removes
# them, and there is no applied-migration ledger anywhere else.


# Never commit packaged env/secret bundles
*.env.zip

# Private Legal Assistant state
.orchestrator-state/

# Generated PDF.js assets from pinned dependency
/public/vendor/pdfjs/
__pycache__/
